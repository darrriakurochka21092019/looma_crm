# npm run setup generates local passwords. Never commit .env.
DATABASE_URL=postgres://looma:CHANGE_ME@127.0.0.1:5432/looma
POSTGRES_USER=looma
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=looma
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
COOKIE_SECURE=false
STORAGE_DIR=./storage
COMPANY_TIMEZONE=Europe/Moscow
# Used only by explicit npm run db:seed; demo users share this local password.
SEED_PASSWORD=CHANGE_ME
